## References to UI labels for numbers
#var number_labels := [
	#$Player1/NumberLabel,
	#$Player2/NumberLabel,
	#$Player3/NumberLabel,
	#$Player4/NumberLabel
#]
#
## Called when a player's increment button is pressed
